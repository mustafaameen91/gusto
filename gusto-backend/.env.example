# Copy to .env on the server and fill in. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=gusto
DB_PASSWORD=change-me
DB_NAME=gusto_db

# Long random strings (e.g. `openssl rand -hex 32`); changing JWT_SECRET logs everyone out
JWT_SECRET=
REFRESH_TOKEN=
SECRET_KEY_CRYPTO=
SECRET_KEY=
SECRET_IV=

# The site's address, so browsers may call the API (the POS app loads the same address)
ALLOWED_ORIGINS=https://gusto.codility.tech
TZ=Asia/Baghdad
